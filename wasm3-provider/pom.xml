<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tegmentum.webassembly4j</groupId>
        <artifactId>webassembly4j-parent</artifactId>
        <version>2.2.0</version>
    </parent>

    <artifactId>wasm3-provider</artifactId>
    <packaging>jar</packaging>

    <name>WebAssembly4J wasm3 Provider</name>
    <description>wasm3 engine provider for WebAssembly4J (backed by wasm34j)</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <wasm34j.version>0.5.0-1.0.0</wasm34j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.tegmentum.webassembly4j</groupId>
            <artifactId>webassembly4j-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.tegmentum.wasm34j</groupId>
            <artifactId>wasm34j</artifactId>
            <version>${wasm34j.version}</version>
        </dependency>

        <!--
            Bundle both wasm34j backends at runtime. wasm34j's RuntimeFactory selects the
            Panama backend (priority 200) on Java 22+ and falls back to JNI (priority 100)
            on Java 17-21; its provider discovery skips the Panama backend (Java 22 bytecode)
            when it cannot be loaded, so bundling both is safe across supported Java versions.
        -->
        <dependency>
            <groupId>ai.tegmentum.wasm34j</groupId>
            <artifactId>wasm34j-jni</artifactId>
            <version>${wasm34j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ai.tegmentum.wasm34j</groupId>
            <artifactId>wasm34j-panama</artifactId>
            <version>${wasm34j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
