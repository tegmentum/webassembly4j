<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tegmentum.webassembly4j</groupId>
        <artifactId>webassembly4j-parent</artifactId>
        <version>2.5.0</version>
    </parent>

    <artifactId>wasmtime4j-provider</artifactId>
    <packaging>jar</packaging>

    <name>WebAssembly4J Wasmtime Provider</name>
    <description>Wasmtime engine provider for WebAssembly4J</description>

    <dependencies>
        <dependency>
            <groupId>ai.tegmentum.webassembly4j</groupId>
            <artifactId>webassembly4j-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.tegmentum</groupId>
            <artifactId>wasmtime4j</artifactId>
        </dependency>
        <!--
            Bundle the JNI native runtime so the provider works out of the box
            on any supported Java version (11+). Users on Java 23+ who prefer the
            Panama (FFM) backend can add ai.tegmentum:wasmtime4j-panama themselves;
            it is intentionally not bundled because its classes are Java 22 bytecode
            and would break ServiceLoader-based extension points on older JVMs.
        -->
        <dependency>
            <groupId>ai.tegmentum</groupId>
            <artifactId>wasmtime4j-jni</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Build the counter_component Rust component before tests run so
                WasmtimeCallableResourceTest has a fresh artifact on the
                classpath. Guarded by the `-Dskip.rust.build` and `-DskipTests`
                escape hatches so CI environments without a Rust toolchain can
                still build the JAR (the test itself is gated on runtime
                availability via `@EnabledIf`).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>build-counter-component</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${project.basedir}/src/test/rust/counter_component</workingDirectory>
                            <arguments>
                                <argument>component</argument>
                                <argument>build</argument>
                                <argument>--release</argument>
                                <argument>--target</argument>
                                <argument>wasm32-wasip2</argument>
                            </arguments>
                            <skip>${skip.rust.build}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-counter-component</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cp</executable>
                            <arguments>
                                <argument>${project.basedir}/src/test/rust/counter_component/target/wasm32-wasip2/release/counter_component.wasm</argument>
                                <argument>${project.basedir}/src/test/resources/counter_component.wasm</argument>
                            </arguments>
                            <skip>${skip.rust.build}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!--
            Set to true to skip the counter_component Rust build (e.g. on CI
            where a `cargo component` toolchain isn't installed). The already
            checked-in counter_component.wasm under src/test/resources/ is
            used as-is; the runtime test then verifies against whatever the
            checked-in artifact represents.
        -->
        <skip.rust.build>false</skip.rust.build>
    </properties>
</project>
