// wasmos:host/embedder — v0.1.0
//
// The embedder-facing WIT world exported by wasmcm_runtime_guest.wasm.
// Per ADR-006, this is the single surface any embedder (JVM, Rust
// CLI, Node, browser, Python, embedded) integrates against; the
// only hand-written native code per embedder is a `wasmos_start`
// shim that boots the runtime guest on that embedder's Wasm engine.
// Everything else is generated by per-language bindgen consuming
// this world.
//
// The world has two halves:
//   - `embedder-api` — exported by the guest, called by the host to
//     load components, register providers, instantiate, invoke, and
//     introspect.
//   - `embedder-callbacks` — imported by the guest, called back into
//     the host to dispatch registered-provider functions and to
//     satisfy the narrow set of syscall-shaped primitives the
//     runtime guest itself needs (clock, random).
//
// Status: draft. The shape follows ADR-006. Concrete signatures
// are expected to iterate as the first bindgen tool (webassembly4j
// per ADR-005) produces its first generated surface and calls it
// end-to-end.

package wasmos:host@0.1.0;

interface embedder-api {
    // -----------------------------------------------------------------
    // Errors.
    //
    // Every fallible export returns `result<T, error>` with a coded
    // reason and a free-form message. Codes let generated bindings
    // map cleanly to language-level exception types; the message is
    // for diagnostics.
    // -----------------------------------------------------------------

    enum error-code {
        // The bytes passed to `runtime-instance.instantiate` did not
        // parse or validate as a Component Model binary.
        invalid-component,
        // A component import name was not satisfied by any entry in
        // the `imports` list passed to `instantiate`.
        unsatisfied-import,
        // `call-export` was invoked with a name not present in the
        // instantiated component's exports.
        missing-export,
        // A host-side dispatcher (via `embedder-callbacks.host-call`)
        // returned an error. The `error.message` carries the
        // host-side reason string verbatim.
        host-callback-failed,
        // Guest execution trapped (unreachable, out-of-bounds,
        // integer overflow, div-by-zero, etc.).
        trap,
        // `verify-world` found a structural mismatch against the
        // expected WIT source.
        wit-mismatch,
        // Anything else. Prefer a specific variant when the category
        // is known.
        other,
    }

    record error {
        code: error-code,
        message: string,
    }

    // -----------------------------------------------------------------
    // Host-provided implementations of imported WIT interfaces.
    //
    // Before `instantiate`, the host registers each WIT interface it
    // will satisfy by constructing a `host-provider` — a triple of
    // (interface name, function count, opaque handle). The `handle`
    // is then referenced from the `imports` list to bind that
    // interface. Dispatch of individual function calls goes through
    // `embedder-callbacks.host-call`, keyed on (handle, func-idx).
    // -----------------------------------------------------------------

    resource host-provider {
        // Register a host-implemented WIT interface. `interface-name`
        // is the fully-qualified name (e.g. `wasip2:host/primitives@0.1.0`)
        // and `num-funcs` is the count of functions in the interface
        // as seen by the guest. The number is used for bounds-checking
        // on dispatch; mismatches surface as
        // `error-code::host-callback-failed`.
        constructor(interface-name: string, num-funcs: u32);
    }

    // -----------------------------------------------------------------
    // Import satisfaction records.
    //
    // Passed as a list to `runtime-instance.instantiate`. Each entry
    // pairs an import's interface name (as it appears in the component
    // binary) with the `host-provider` handle that satisfies it.
    // Ordering does not matter; the runtime matches on name.
    // -----------------------------------------------------------------

    record import-satisfaction {
        interface-name: string,
        provider: borrow<host-provider>,
    }

    // -----------------------------------------------------------------
    // Runtime instance.
    //
    // An instantiated Component Model component with all imports
    // satisfied and ready to receive export invocations. Owned by
    // the caller; drop the resource to release the underlying
    // runtime state.
    // -----------------------------------------------------------------

    resource runtime-instance {
        // Load, validate, and instantiate a Component Model binary
        // with the supplied import satisfactions. Returns the
        // instance on success or a coded `error` on failure.
        //
        // The `component-bytes` list is copied into runtime-owned
        // memory; the caller may free its buffer immediately after
        // this call returns.
        instantiate: static func(
            component-bytes: list<u8>,
            imports: list<import-satisfaction>,
        ) -> result<runtime-instance, error>;

        // Invoke an exported function by fully-qualified name.
        //
        // `args` is a Canonical-ABI-encoded byte string; the calling
        // language's generated bindings own the typed-to-bytes
        // encoding. The `list<u8>` return is the encoded return
        // value in the same shape. Errors surface as coded `error`.
        //
        // Interacts with the M10 generated adapter cache: hot paths
        // dispatch through pre-compiled adapters when available and
        // fall back to the interpreter otherwise. Neither behaviour
        // is observable through this surface.
        call-export: func(
            name: string,
            args: list<u8>,
        ) -> result<list<u8>, error>;

        // Dump the instantiated component's WIT surface (imports,
        // exports, resource types, records, variants, etc.) as a
        // JSON string. Format matches `wasmcm inspect --wit
        // --format=json` today; expected to be documented as a
        // stable schema before this ADR promotes to Accepted.
        introspect: func() -> string;

        // Verify the instantiated component's world structurally
        // matches `expected-wit` (a WIT-source string). Returns an
        // empty ok on match, or `error` with code `wit-mismatch`
        // and a message describing the first divergence.
        //
        // Subtype rules mirror `wasmcm validate --against`: record
        // and variant width subtyping, tuple positional exact,
        // join-of-variants flattening, resource identity via
        // qualified names + generational handles.
        verify-world: func(expected-wit: string) -> result<_, error>;
    }
}

interface embedder-callbacks {
    // -----------------------------------------------------------------
    // Host-implemented import dispatcher.
    //
    // Called by the guest during `call-export` execution whenever a
    // running component invokes a function on an imported interface
    // that was satisfied by a host `host-provider`. The embedder is
    // responsible for looking up (provider-handle, func-idx) in its
    // registered-provider table and invoking the language-level
    // implementation with `args` decoded and results encoded per
    // the Canonical ABI (again, generated bindings own the typed
    // encoding).
    //
    // An error string maps back to `error-code::host-callback-failed`
    // on the guest side.
    // -----------------------------------------------------------------

    host-call: func(
        provider-handle: u32,
        func-idx: u32,
        args: list<u8>,
    ) -> result<list<u8>, string>;

    // -----------------------------------------------------------------
    // Syscall-shaped primitives the runtime guest itself needs from
    // the embedder. Distinct from `wasi:clocks` / `wasi:random`
    // interfaces implemented by wasi-p2 components — those live one
    // layer up and route through `host-call`. These are the runtime
    // guest's *own* dependencies.
    // -----------------------------------------------------------------

    // Monotonic nanoseconds since an unspecified epoch. Used by the
    // runtime guest for deadline tracking, resource-table generation
    // counters, and diagnostic timestamps. No monotonicity guarantee
    // across `wasmos_start` calls in the same host process.
    now-monotonic-ns: func() -> u64;

    // Fill a buffer with `len` cryptographically random bytes. Used
    // by the runtime guest for resource-handle randomization. If
    // the host cannot satisfy the request (e.g. missing entropy on
    // an embedded target) it returns an empty list; guest treats
    // that as unavailable and falls back to deterministic seeding.
    read-random: func(len: u32) -> list<u8>;
}

world embedder {
    export embedder-api;
    import embedder-callbacks;
}
