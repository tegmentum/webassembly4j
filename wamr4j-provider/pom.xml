<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tegmentum.webassembly4j</groupId>
        <artifactId>webassembly4j-parent</artifactId>
        <version>2.3.0</version>
    </parent>

    <artifactId>wamr4j-provider</artifactId>
    <packaging>jar</packaging>

    <name>WebAssembly4J WAMR Provider</name>
    <description>WAMR engine provider for WebAssembly4J</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.tegmentum.webassembly4j</groupId>
            <artifactId>webassembly4j-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.tegmentum.wamr4j</groupId>
            <artifactId>wamr4j</artifactId>
        </dependency>
        <!--
            Bundle the JNI native runtime so the provider works out of the box on
            any supported Java version (17+). The Panama (FFM) backend is NOT
            bundled: wamr4j discovers runtimes via ServiceLoader and its Panama
            provider is Java 22 bytecode, so its mere presence on a Java 17-21
            classpath would raise a ServiceConfigurationError and break discovery
            of all runtimes (including JNI). Users on Java 22+ who want Panama can
            add ai.tegmentum.wamr4j:wamr4j-panama themselves.
        -->
        <dependency>
            <groupId>ai.tegmentum.wamr4j</groupId>
            <artifactId>wamr4j-jni</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
