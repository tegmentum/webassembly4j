<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.tegmentum.webassembly4j</groupId>
        <artifactId>webassembly4j-parent</artifactId>
        <version>2.5.2-SNAPSHOT</version>
    </parent>

    <artifactId>wasmos-provider</artifactId>
    <packaging>jar</packaging>

    <name>WebAssembly4J wasmos Provider</name>
    <description>
        wasmos engine provider — a wasmtime-backed component runtime that
        pre-links the wasmos-runtime host surface (host:wasmtime,
        host:bootstrap, host:caps, host:grants, wasmos:host/*) plus
        wasi:p2 onto every component instance. Backed by a JNI wrapper
        cdylib that links wasmos-runtime (Rust crate at ~/git/wasmos).
    </description>

    <properties>
        <!--
            Cargo target directory sits OUTSIDE Maven's target/ so `mvn clean`
            doesn't nuke the ~5 minutes of wasmtime + wasmos-runtime
            compilation. Same pattern as wasmtime4j-native/pom.xml.
        -->
        <native.cargo.target.dir>${project.basedir}/.cargo-target</native.cargo.target.dir>
        <native.crate.dir>${project.basedir}/native</native.crate.dir>
        <cargo.build.mode>release</cargo.build.mode>

        <!--
            skip.native.build=true skips the cargo step entirely. Use when
            the platform's native was staged into src/main/resources/natives
            by a CI matrix job. Default false because the primary consumers
            today are developer machines with a Rust toolchain.
        -->
        <skip.native.build>false</skip.native.build>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ai.tegmentum.webassembly4j</groupId>
            <artifactId>webassembly4j-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <!--
                        Build the JNI wrapper cdylib. Bound to generate-resources
                        (before process-resources copies natives into
                        target/classes) so a fresh checkout `mvn install` produces
                        a jar with the platform's native library in it.
                    -->
                    <execution>
                        <id>cargo-build-wasmos-provider-native</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${native.crate.dir}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--${cargo.build.mode}</argument>
                            </arguments>
                            <environmentVariables>
                                <CARGO_TARGET_DIR>${native.cargo.target.dir}</CARGO_TARGET_DIR>
                                <RUST_BACKTRACE>1</RUST_BACKTRACE>
                            </environmentVariables>
                            <skip>${skip.native.build}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!--
                        Copy the built dylib into the jar under the
                        /natives/{platform}/ layout that WasmosNativeLoader
                        expects. Uses <ant> to pick up whichever of
                        libwasmos_provider.{dylib,so} / wasmos_provider.dll
                        was produced on this host. Windows condition +
                        include glob are wired below; the Windows path has
                        not been verified on a real Windows host — CI
                        should exercise it end-to-end before we advertise
                        Windows support.
                    -->
                    <execution>
                        <id>stage-native-library</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target unless="${skip.native.build}">
                                <condition property="native.platform.dir" value="darwin-aarch64">
                                    <and>
                                        <os family="mac"/>
                                        <or>
                                            <os arch="aarch64"/>
                                            <os arch="arm64"/>
                                        </or>
                                    </and>
                                </condition>
                                <condition property="native.platform.dir" value="darwin-x86_64">
                                    <and>
                                        <os family="mac"/>
                                        <or>
                                            <os arch="x86_64"/>
                                            <os arch="amd64"/>
                                        </or>
                                    </and>
                                </condition>
                                <condition property="native.platform.dir" value="linux-aarch64">
                                    <and>
                                        <os family="unix"/>
                                        <not><os family="mac"/></not>
                                        <or>
                                            <os arch="aarch64"/>
                                            <os arch="arm64"/>
                                        </or>
                                    </and>
                                </condition>
                                <condition property="native.platform.dir" value="linux-x86_64">
                                    <and>
                                        <os family="unix"/>
                                        <not><os family="mac"/></not>
                                        <or>
                                            <os arch="x86_64"/>
                                            <os arch="amd64"/>
                                        </or>
                                    </and>
                                </condition>
                                <condition property="native.platform.dir" value="windows-x86_64">
                                    <and>
                                        <os family="windows"/>
                                        <or>
                                            <os arch="x86_64"/>
                                            <os arch="amd64"/>
                                        </or>
                                    </and>
                                </condition>

                                <fail unless="native.platform.dir">
                                    Unknown OS/arch combination for wasmos-provider native
                                    staging. Set -Dskip.native.build=true to skip, or add a
                                    matching &lt;condition&gt; in wasmos-provider/pom.xml.
                                </fail>

                                <mkdir dir="${project.build.outputDirectory}/natives/${native.platform.dir}"/>
                                <copy todir="${project.build.outputDirectory}/natives/${native.platform.dir}"
                                      flatten="true"
                                      failonerror="true">
                                    <fileset dir="${native.cargo.target.dir}/${cargo.build.mode}">
                                        <include name="libwasmos_provider.dylib"/>
                                        <include name="libwasmos_provider.so"/>
                                        <include name="wasmos_provider.dll"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Clean removes ONLY Maven's target/, NOT the .cargo-target/
                sibling — same policy as wasmtime4j-native. Force a full
                Rust rebuild with `rm -rf wasmos-provider/.cargo-target`.
            -->
        </plugins>
    </build>
</project>
